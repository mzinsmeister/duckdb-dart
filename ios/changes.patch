diff --git a/Makefile b/Makefile
index 345837b..ce9f03b 100644
--- a/Makefile
+++ b/Makefile
@@ -311,9 +311,27 @@ ifneq (${STANDARD_VECTOR_SIZE}, )
 	CMAKE_VARS:=${CMAKE_VARS} -DSTANDARD_VECTOR_SIZE=${STANDARD_VECTOR_SIZE}
 endif
 
+ifneq ("${BUILD_TESTING}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DBUILD_TESTING='${BUILD_TESTING}'
+endif
+
+ifneq ("${BUILD_UNITTESTS}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DBUILD_UNITTESTS=${BUILD_UNITTESTS}
+endif
+
+ifneq ("${IOS_PLATFORM}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DIOS_PLATFORM='${IOS_PLATFORM}'
+endif
+ifneq ("${CMAKE_TOOLCHAIN_FILE}", "")
+	CMAKE_VARS_BUILD:=${CMAKE_VARS_BUILD} -DCMAKE_TOOLCHAIN_FILE='${CMAKE_TOOLCHAIN_FILE}'
+endif
+ifneq ("${BUILD_SHELL}", "")
+	CMAKE_VARS:=${CMAKE_VARS} -DBUILD_SHELL=${BUILD_SHELL}
+endif
+
 # Enable VCPKG for this build
 ifneq ("${VCPKG_TOOLCHAIN_PATH}", "")
-	CMAKE_VARS_BUILD:=${CMAKE_VARS_BUILD} -DCMAKE_TOOLCHAIN_FILE='${VCPKG_TOOLCHAIN_PATH}' -DVCPKG_BUILD=1
+	CMAKE_VARS_BUILD:=${CMAKE_VARS_BUILD} -DVCPKG_TOOLCHAIN_PATH='${VCPKG_TOOLCHAIN_PATH}' -DVCPKG_BUILD=1
 endif
 ifneq ("${VCPKG_TARGET_TRIPLET}", "")
 	CMAKE_VARS_BUILD:=${CMAKE_VARS_BUILD} -DVCPKG_TARGET_TRIPLET='${VCPKG_TARGET_TRIPLET}'
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index a5519a3..184a00d 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -110,6 +110,39 @@ link_extension_libraries(duckdb PRIVATE)
 
 link_threads(duckdb PUBLIC)
 
+# iOS framework build (duckdb-dart)
+if(APPLE)
+  string(SUBSTRING ${DUCKDB_VERSION} 1 -1 DUCKDB_VERSION_NO_PREFIX)
+  configure_file(${CMAKE_CURRENT_SOURCE_DIR}/Info.plist.in
+                 ${CMAKE_CURRENT_BINARY_DIR}/Info.plist @ONLY)
+
+  add_library(duckdb_framework SHARED ${ALL_OBJECT_FILES} ${LINK_OBJECTS}
+                                      "${PROJECT_SOURCE_DIR}/src/include/duckdb.h")
+  target_link_libraries(duckdb_framework PUBLIC ${DUCKDB_SYSTEM_LIBS})
+  link_extension_libraries(duckdb_framework PRIVATE)
+  link_threads(duckdb_framework PUBLIC)
+  target_include_directories(
+    duckdb_framework
+    PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+           $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
+  set_target_properties(
+    duckdb_framework
+    PROPERTIES OUTPUT_NAME "duckdb"
+               FRAMEWORK TRUE
+               FRAMEWORK_VERSION A
+               MACOSX_FRAMEWORK_IDENTIFIER org.duckdb
+               MACOSX_FRAMEWORK_INFO_PLIST ${CMAKE_CURRENT_BINARY_DIR}/Info.plist
+               PUBLIC_HEADER "${PROJECT_SOURCE_DIR}/src/include/duckdb.h"
+               VERSION 1.0.0
+               SOVERSION 1.0.0)
+  install(
+    TARGETS duckdb_framework
+    EXPORT "${DUCKDB_EXPORT_SET}"
+    LIBRARY DESTINATION "${INSTALL_LIB_DIR}"
+    FRAMEWORK DESTINATION "${INSTALL_LIB_DIR}"
+    PUBLIC_HEADER DESTINATION "include")
+endif()
+
 if(SET_DUCKDB_LIBRARY_VERSION)
   set_target_properties(
     duckdb PROPERTIES VERSION ${DUCKDB_VERSION_NUMBER}
